# ~/.config/ghostty/config

# --- appearance ---
font-family = JetBrainsMono Nerd Font
font-size = 16
# Igual que el tema de tmux y el de nvim. Ghostty lo trae de serie, no hace
# falta instalarlo: `ghostty +list-themes` lista los 463 disponibles.
# background #181616 / foreground #c5c9c5, los mismos valores exactos que usa
# el tema de tmux, así que el fondo del terminal y el de tmux no se notan.
theme = Kanagawa Dragon
background-opacity = 1.0
cursor-style = block
cursor-style-blink = false

# --- terminal compatibility (critical for nvim) ---
term = xterm-256color
bold-is-bright = false

# --- clipboard integration ---
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# --- mouse ---
mouse-hide-while-typing = true
focus-follows-mouse = false

# --- scrollback ---
scrollback-limit = 10000

# --- window ---
window-decoration = auto
macos-titlebar-style = transparent
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
resize-overlay = never

# --- keybinds: let tmux own prefix, avoid conflicts ---
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+0=reset_font_size
