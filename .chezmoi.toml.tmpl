sourceDir = "{{ .chezmoi.homeDir }}/.config/dotfiles"

{{- $isWork := promptBoolOnce . "is_work" "Is this a work machine? (y/n)" }}

[data]
  is_work = {{ $isWork }}
{{- if $isWork }}
  name = {{ promptStringOnce . "name" "Full name" | quote }}
  email = {{ promptStringOnce . "email" "Work email" | quote }}
  github_user = {{ promptStringOnce . "github_user" "GitHub username" | quote }}
{{- else }}
  name = "Victorino Lavida"
  email = "victorino.lavida@gmail.com"
  github_user = "Victorinolavida"
{{- end }}
