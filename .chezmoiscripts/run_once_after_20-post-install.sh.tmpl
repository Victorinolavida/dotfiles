#!/usr/bin/env bash
# Corre después de escribir los dotfiles y clonar los externals:
# ya existen ~/.tmux.conf y ~/.tmux/plugins/tpm.
set -euo pipefail

has()  { command -v "$1" >/dev/null 2>&1; }
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }

# ─── Plugins de tmux ──────────────────────────────────────────────────────────
# install_plugins necesita un servidor tmux vivo; se levanta uno desechable.
if has tmux && [ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ]; then
  log "Instalando plugins de tmux (TPM)"
  started=0
  if ! tmux has-session 2>/dev/null; then
    tmux new-session -d -s tpm-bootstrap && started=1
  fi
  "$HOME/.tmux/plugins/tpm/bin/install_plugins" \
    || warn "TPM falló; abre tmux y pulsa prefix + I (C-x I)"
  [ "$started" = 1 ] && tmux kill-session -t tpm-bootstrap 2>/dev/null || true
fi

# ─── zsh como shell por defecto ───────────────────────────────────────────────
# Sólo si el shell actual no es zsh. Comparar contra la ruta exacta sobraría:
# /bin/zsh y el zsh de brew son ambos válidos, y cambiar de uno a otro sólo
# serviría para pedir sudo y contraseña sin motivo.
zsh_path=$(command -v zsh || true)
if [ -n "$zsh_path" ] && [ "$(basename "${SHELL:-}")" != zsh ]; then
  if ! grep -qxF "$zsh_path" /etc/shells 2>/dev/null; then
    echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null
  fi
  log "Cambiando el shell por defecto a $zsh_path"
  chsh -s "$zsh_path" || warn "chsh falló; córrelo a mano: chsh -s $zsh_path"
fi
