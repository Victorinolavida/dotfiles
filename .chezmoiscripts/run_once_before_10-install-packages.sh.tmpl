#!/usr/bin/env bash
# Instala las herramientas que asumen dot_zshrc y dot_tmux.conf.
# Corre una sola vez por hash de contenido, antes de escribir cualquier dotfile.
set -euo pipefail

has()  { command -v "$1" >/dev/null 2>&1; }
log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }

{{ if eq .chezmoi.os "darwin" -}}
# ─── macOS ────────────────────────────────────────────────────────────────────
if ! has brew; then
  log "Instalando Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)"
fi

log "Instalando paquetes con brew"
brew install \
  git curl zsh tmux \
  eza bat fzf fd ripgrep zoxide direnv \
  lazygit neovim \
  go fnm

# `brew install --cask` sale con error si el cask ya está instalado, y con
# set -e eso abortaría el resto del script
if ! brew list --cask font-jetbrains-mono-nerd-font >/dev/null 2>&1; then
  brew install --cask font-jetbrains-mono-nerd-font
fi

{{ else if eq .chezmoi.os "linux" -}}
# ─── Linux ────────────────────────────────────────────────────────────────────
# La familia se detecta en runtime desde /etc/os-release, así el mismo script
# sirve en Ubuntu, Arch y Fedora (y derivados vía ID_LIKE).
ID=""; ID_LIKE=""
if [ -r /etc/os-release ]; then . /etc/os-release; fi

case " $ID $ID_LIKE " in
  *" debian "*|*" ubuntu "*) FAMILY=debian ;;
  *" arch "*)                FAMILY=arch   ;;
  *" fedora "*|*" rhel "*)   FAMILY=fedora ;;
  *) echo "Distro no soportada: ID=$ID ID_LIKE=$ID_LIKE" >&2; exit 1 ;;
esac
log "Distro detectada: $ID (familia $FAMILY)"

ARCH=$(uname -m)

pm_install() {
  case "$FAMILY" in
    debian) sudo apt-get install -y "$@" ;;
    arch)   sudo pacman -S --needed --noconfirm "$@" ;;
    fedora) sudo dnf install -y "$@" ;;
  esac
}

# Igual que pm_install pero uno por uno y sin abortar: los nombres de paquete
# no coinciden entre Ubuntu/Arch/Fedora y hay repos donde alguno no existe.
# Lo que no entre por aquí lo recogen los fallbacks de más abajo.
pm_try() {
  local p
  for p in "$@"; do
    pm_install "$p" >/dev/null 2>&1 || warn "no disponible en los repos de $ID: $p"
  done
}

gh_latest() { # gh_latest <owner/repo> -> tag sin la "v"
  curl -fsSL "https://api.github.com/repos/$1/releases/latest" \
    | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1
}

# Lo imprescindible va en pm_install (si falla, el script debe parar);
# el resto en pm_try, porque la disponibilidad varía entre distros y versiones.
case "$FAMILY" in
  debian)
    log "Actualizando índices de apt"
    sudo apt-get update -qq
    pm_install git curl wget unzip zsh tmux ripgrep build-essential xclip
    # bat y fd se llaman batcat/fdfind aquí; eza sólo está en 24.04+
    pm_try fzf fd-find zoxide direnv bat golang-go eza
    ;;
  arch)
    pm_install git curl wget unzip zsh tmux ripgrep base-devel xclip
    pm_try fzf fd zoxide direnv bat eza go neovim lazygit fnm \
           ttf-jetbrains-mono-nerd
    ;;
  fedora)
    pm_install git curl wget unzip zsh tmux ripgrep xclip
    pm_try fzf fd-find zoxide direnv bat eza golang neovim lazygit \
           @development-tools
    ;;
esac

# ── Debian/Ubuntu: alias de binarios con nombre distinto ──────────────────────
mkdir -p "$HOME/.local/bin"
if has batcat && ! has bat; then ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"; fi
if has fdfind && ! has fd;  then ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd";  fi
export PATH="$HOME/.local/bin:$PATH"

# ── eza: en Ubuntu <24.04 no está en los repos ────────────────────────────────
if ! has eza && [ "$FAMILY" = debian ]; then
  log "Instalando eza desde deb.gierens.de"
  sudo mkdir -p /etc/apt/keyrings
  wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc \
    | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
  echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" \
    | sudo tee /etc/apt/sources.list.d/gierens.list >/dev/null
  sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
  sudo apt-get update -qq && pm_install eza
fi

# ── neovim: la versión de apt va muy atrasada, se usa el tarball oficial ──────
if ! has nvim; then
  case "$ARCH" in
    x86_64)  nvim_asset=nvim-linux-x86_64 ;;
    aarch64) nvim_asset=nvim-linux-arm64  ;;
    *) nvim_asset="" ;;
  esac
  if [ -n "$nvim_asset" ]; then
    log "Instalando neovim desde releases de GitHub"
    curl -fsSL -o /tmp/nvim.tar.gz \
      "https://github.com/neovim/neovim/releases/latest/download/${nvim_asset}.tar.gz"
    sudo rm -rf "/opt/${nvim_asset}"
    sudo tar -C /opt -xzf /tmp/nvim.tar.gz
    sudo ln -sf "/opt/${nvim_asset}/bin/nvim" /usr/local/bin/nvim
    rm -f /tmp/nvim.tar.gz
  else
    warn "arquitectura $ARCH sin binario de neovim, instálalo a mano"
  fi
fi

# ── lazygit ───────────────────────────────────────────────────────────────────
if ! has lazygit; then
  case "$ARCH" in
    x86_64)  lg_arch=x86_64 ;;
    aarch64) lg_arch=arm64  ;;
    *) lg_arch="" ;;
  esac
  if [ -n "$lg_arch" ] && v=$(gh_latest jesseduffield/lazygit) && [ -n "$v" ]; then
    log "Instalando lazygit $v"
    curl -fsSL -o /tmp/lazygit.tar.gz \
      "https://github.com/jesseduffield/lazygit/releases/download/v${v}/lazygit_${v}_Linux_${lg_arch}.tar.gz"
    tar -xf /tmp/lazygit.tar.gz -C /tmp lazygit
    sudo install /tmp/lazygit /usr/local/bin/lazygit
    rm -f /tmp/lazygit /tmp/lazygit.tar.gz
  else
    warn "no se pudo instalar lazygit automáticamente"
  fi
fi

# ── fnm (dot_zshrc lo busca en ~/.local/share/fnm) ────────────────────────────
if ! has fnm && [ ! -x "$HOME/.local/share/fnm/fnm" ]; then
  log "Instalando fnm"
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell
fi

# ── JetBrainsMono Nerd Font (la necesitan p10k, eza --icons y el status de tmux)
if has fc-list && ! fc-list | grep -qi "JetBrainsMono Nerd Font"; then
  log "Instalando JetBrainsMono Nerd Font"
  font_dir="$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
  mkdir -p "$font_dir"
  curl -fsSL -o /tmp/JetBrainsMono.zip \
    "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip"
  unzip -qo /tmp/JetBrainsMono.zip -d "$font_dir"
  rm -f /tmp/JetBrainsMono.zip
  fc-cache -f "$font_dir" >/dev/null
fi

{{ end -}}

# ─── Oh My Zsh (todas las plataformas) ────────────────────────────────────────
# Va aquí, en un script "before", porque el instalador se niega a correr si
# ~/.oh-my-zsh ya existe — y los externals de .chezmoiexternal.toml crean
# ~/.oh-my-zsh/custom/... más adelante en este mismo apply.
if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
  log "Instalando Oh My Zsh"
  KEEP_ZSHRC=yes RUNZSH=no CHSH=no \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" \
    "" --unattended
fi
